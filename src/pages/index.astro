---
import Layout from '../layouts/Layout.astro';
import ListeningShelf from '../components/ListeningShelf.astro';
import { format } from 'date-fns';

type PostEntry = {
  frontmatter: { slug: string; title: string; date: string };
};
const posts = Object.values(
  import.meta.glob('../posts/*.md', { eager: true })
) as PostEntry[];
---

<Layout title="Welcome to Astro.">
	<main>
		<div class="leading-relaxed tracking-tight text-indigo-900 subpixel-antialiased">
    <h1 class="mb-4 mt-2">
      👋 <span data-home-welcome>Hello.</span> I'm Mark.
    </h1>
    <script>
      const WELCOMES = [
        'Hey!',
        'Hello.',
        'Hi!',
        'Yo!',
        'Sup!',
        'Now then.',
        'Yello!',
        'Howdy!',
      ];
      const el = document.querySelector('[data-home-welcome]');
      if (el) {
        el.textContent = WELCOMES[Math.floor(Math.random() * WELCOMES.length)] ?? 'Hello.';
      }
    </script>

    <p>For the last twenty years I have been building web applications, automating business processes and helping start-ups grow.</p>
    <p>
      Previously contracting at <a href="http://the49.com/" target="_blank">the49</a> as Software Engineer, Head of Engineering at <a href="https://orcascan.com" target="_blank">Orca Scan</a> and Product Director <a href="https://mobilleo.com" target="_blank">Mobilleo</a>.
    </p>
    <ListeningShelf class="my-10" />
    <h1 class="mb-4 mt-2">
      ✍️ Writing and rambling.
    </h1>
    {posts.map(post =>
      <h6 class="m-0">
        {format(new Date(post.frontmatter.date), 'EEEE, do MMMM yyyy')}
      </h6>
      <h3>
        <a
          href={`/posts/${post.frontmatter.slug}`}
          class="font-bold underline"
        >
          {post.frontmatter.title}
        </a>
      </h3>
    )}
  </div>
	</main>
</Layout>
