---
import {
  LISTENING_SHELF_DEFAULTS,
  resolveListeningShelfConfig,
  type ListeningShelfAudioConfig,
  type ListeningShelfHoverConfig,
  type ListeningShelfLayout,
  type ListeningShelfStackConfig,
  type ListeningShelfVisualConfig,
} from '../lib/listening-shelf/config';

export interface Props {
  class?: string;
  /** e.g. "Recently listening" — omit to render no title */
  heading?: string;
  /** When the API returns no art */
  whenEmpty?: 'hide' | 'message';
  /** Last.fm user; if omitted, uses `import.meta.env.PUBLIC_LASTFM_USER` or `irPhunky` */
  lastfmUser?: string;
  maxTracks?: number;
  lastfmLimit?: number;
  /** Fetches iTunes for previews; when false, skips iTunes if Last.fm art is real (faster) */
  enablePreviews?: boolean;
  itunesConcurrency?: number;
  layout?: ListeningShelfLayout;
  breakpoint?: string;
  visual?: Partial<ListeningShelfVisualConfig>;
  hover?: Partial<ListeningShelfHoverConfig>;
  audio?: Partial<ListeningShelfAudioConfig>;
  stack?: Partial<ListeningShelfStackConfig>;
}

const {
  class: className,
  heading,
  whenEmpty = 'hide',
  lastfmUser: lastfmUserProp,
  maxTracks = LISTENING_SHELF_DEFAULTS.maxTracks,
  lastfmLimit = LISTENING_SHELF_DEFAULTS.lastfmLimit,
  enablePreviews = true,
  itunesConcurrency = LISTENING_SHELF_DEFAULTS.itunesConcurrency,
  layout,
  breakpoint,
  visual,
  hover,
  audio,
  stack,
} = Astro.props;

const lastfmUser = lastfmUserProp ?? (import.meta.env.PUBLIC_LASTFM_USER || 'irPhunky');
const hasApiKey = Boolean(
  import.meta.env.PUBLIC_LASTFM_API_KEY && import.meta.env.PUBLIC_LASTFM_API_KEY.length > 0
);
const config = resolveListeningShelfConfig({
  maxTracks,
  lastfmLimit,
  itunesConcurrency,
  layout,
  breakpoint,
  visual,
  hover,
  audio,
  stack,
});
const rootStyle = [
  `--listening-tile-size: ${config.visual.tileSize}`,
  `--listening-step-factor: ${config.visual.overlap}`,
  `--listening-gap: ${config.visual.gap}`,
  `--listening-stack-tile: ${config.visual.stackTileSize}`,
  `--listening-label-max: ${config.visual.labelMaxWidth}`,
  `--listening-peek-scale: ${config.hover.scale}`,
  `--listening-peek-rotation: ${config.hover.rotationDeg}deg`,
].join('; ');
---

{
  !hasApiKey && whenEmpty === 'hide' ? null : !hasApiKey && whenEmpty === 'message' ? (
    <p class:list={['text-gray-600', className]}>No recent tracks right now.</p>
  ) : (
    <div
      class:list={['listening-shelf-root', className]}
      data-listening-shelf
      data-when-empty={whenEmpty}
      data-lastfm-user={lastfmUser}
      data-listening-config={JSON.stringify(config)}
      data-enable-previews={enablePreviews ? 'true' : 'false'}
      style={rootStyle}
    >
      {heading && (
        <h2 class="mb-4 mt-0 text-2xl font-bold text-indigo-900">
          {heading}
        </h2>
      )}
      {hasApiKey && (
        <p class="text-gray-600" data-shelf-status>Loading recent tracks…</p>
      )}
    </div>
  )
}
{
  hasApiKey && (
    <script>
      import { mountListeningShelves } from '../lib/listening-shelf/client-mount';
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          void mountListeningShelves();
        });
      } else {
        void mountListeningShelves();
      }
    </script>
  )
}
<style is:global>
  @reference "tailwindcss";

  .listening-shelf-root {
    overflow: visible;
  }

  .listening-shelf-root .listening-shelf-scroll {
    @apply flex w-full min-w-0 flex-col overflow-x-visible overflow-y-visible bg-transparent;
    gap: var(--listening-gap, 2rem);
    container-type: inline-size;
  }

  /* Desktop fan: keep overflow visible so rotate/scale peek isn’t clipped (overflow-x: clip cut corners) */
  .listening-shelf-root .listening-shelf-scroll:has(.listening-shelf--fan) {
    overflow: visible;
    padding-top: min(0.75rem, 3cqi);
    padding-inline: min(0.85rem, 3.5cqi);
  }

  .listening-shelf-root .listening-shelf {
    --tile: var(--listening-tile-size, min(8rem, calc(200cqi / (var(--count) + 1))));
    --step: calc(var(--listening-step-factor, 0.5) * var(--tile));
    position: relative;
    height: var(--tile);
    /* Fixed footprint: peers move via --peer-shift on hover, not wider layout */
    width: min(
      100%,
      calc((var(--count) + 1) * var(--listening-step-factor, 0.5) * var(--tile))
    );
    max-width: 100%;
    margin-inline: auto;
    overflow: visible;
    background: transparent;
  }

  /* Narrow / stacked variant (≤767px binds `listening-shelf--stack` in TS) */
  .listening-shelf-root .listening-shelf--stack {
    --stack-tile: var(--listening-stack-tile, min(17rem, min(94cqi, min(92vw, 22rem))));
    width: 100%;
    max-width: 100%;
    /* Tile + room below art; avoid calc(var(--stack-tile) + X) — postcss chokes on nested min() */
    min-height: var(--stack-tile);
    height: auto;
    padding-bottom: 3rem;
    touch-action: pan-y;
  }

  .listening-shelf-root .listening-shelf--stack .album-art {
    width: var(--stack-tile);
    height: var(--stack-tile);
    top: 0.25rem;
    overflow: visible;
  }

  .listening-shelf-root .listening-shelf--stack .album-art--stack-top {
    touch-action: none;
  }

  .listening-shelf-root .listening-shelf--stack .album-art img {
    -webkit-touch-callout: none;
    -webkit-user-drag: none;
    user-drag: none;
    user-select: none;
    pointer-events: none;
  }

  /* Shrinks to label; rotates with artwork via JS (same angle as stack) */
  .listening-shelf-root .listening-shelf--stack .listening-track-line {
    position: absolute;
    left: 50%;
    /* ~half tile + art offset; literals only so postcss-calc does not expand --stack-tile */
    top: calc(0.25rem + min(8.5rem, min(47cqi, 46vw)));
    width: max-content;
    max-width: min(var(--listening-label-max, 16rem), calc(100% - 1rem));
    min-height: unset;
    transform: translate(-50%, -50%);
    text-align: center;
    pointer-events: none;
    z-index: 70;
  }

  .listening-shelf-root .listening-shelf--stack .listening-track-line .listening-track-now {
    position: relative;
    display: inline-block;
    max-width: min(var(--listening-label-max, 16rem), calc(100% - 1rem));
    vertical-align: top;
    text-align: center;
    padding: 0.85rem 1.15rem;
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 0.58);
    color: rgb(30 27 75);
    box-shadow: 0 2px 14px rgb(0 0 0 / 0.1);
    backdrop-filter: blur(7px);
    -webkit-backdrop-filter: blur(7px);
    left: auto;
    right: auto;
  }

  .listening-shelf-root .listening-shelf--stack .listening-track-line .listening-track-title {
    color: rgb(30 27 75);
  }

  .listening-shelf-root .listening-shelf--stack .listening-track-line .listening-track-artist {
    color: rgb(75 85 99);
  }

  .listening-shelf-root .listening-shelf-scroll:has(.listening-shelf--stack) {
    gap: min(1rem, var(--listening-gap, 2rem));
  }

  .listening-shelf-root .listening-shelf--row {
    @apply flex flex-wrap items-start justify-center;
    gap: var(--listening-gap, 2rem);
    width: 100%;
    height: auto;
  }

  .listening-shelf-root .listening-shelf--row .album-art {
    position: relative;
    left: auto;
    top: auto;
    flex: 0 0 var(--tile);
    z-index: auto;
  }

  /* Horizontal fan: overlap L→R; smaller index = further left = higher z, so each cover stays under the one to its left (incl. while peeking — no z-boost) */
  .listening-shelf-root .listening-shelf--fan .album-art {
    z-index: calc(var(--count) + 1 - var(--i));
    transition: transform 380ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Outer shell stays the hit / layout box so peek transforms don’t drop hover / kill the 1s audio timer */
  .listening-shelf-root .album-art {
    @apply absolute top-0 cursor-pointer bg-transparent;
    overflow: visible;
    left: calc(var(--i) * var(--step));
    width: var(--tile);
    height: var(--tile);
    margin: 0;
    transform: translateX(var(--peer-shift, 0px));
    transform-origin: center center;
    transition: transform 380ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .listening-shelf-root .album-art-face {
    @apply h-full w-full drop-shadow-md;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    transform: rotate(0deg) scale(1);
    transform-origin: center center;
    transition:
      transform 380ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 380ms ease,
      top 380ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .listening-shelf-root .album-art img {
    @apply block h-full w-full rounded-lg object-cover bg-transparent;
  }

  /* Peek: center-anchored scale + rotate on face; peers shift via --peer-shift (attach-behavior.ts) */
  .listening-shelf-root .listening-shelf .album-art.album-art--peek .album-art-face {
    @apply drop-shadow-lg;
    top: 0;
    transform: rotate(var(--listening-peek-rotation, 8deg)) scale(var(--listening-peek-scale, 1.28));
    transform-origin: center center;
  }

  .listening-shelf-root .listening-track-line {
    @apply relative w-full min-h-14 shrink-0;
  }

  .listening-shelf-root .listening-track-now {
    @apply text-sm text-indigo-900;
    /* No transition: JS repositions often; animating left/transform made titles drift after hover */
  }

  .listening-shelf-root .listening-track-now[hidden] {
    display: none;
  }

  .listening-shelf-root .listening-track-now .listening-track-title {
    @apply block font-medium;
  }

  .listening-shelf-root .listening-track-now .listening-track-artist {
    @apply block text-gray-600;
  }
</style>
