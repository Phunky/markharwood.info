---
import { fetchListeningCovers } from '../lib/listening-shelf/covers';

export interface Props {
  class?: string;
  /** e.g. "Recently listening" — omit to render no title */
  heading?: string;
  /** When the API returns no art */
  whenEmpty?: 'hide' | 'message';
  /** Last.fm user; if omitted, uses `import.meta.env.LASTFM_USER` or `irPhunky` */
  lastfmUser?: string;
  /**
   * Optional override; if omitted, uses `import.meta.env.LASTFM_API_KEY` (set in `.env`; see `astro.config.mjs`).
   */
  lastfmApiKey?: string;
  maxTracks?: number;
  lastfmLimit?: number;
  /** Fetches iTunes for previews; when false, skips iTunes if Last.fm art is real (faster) */
  enablePreviews?: boolean;
  itunesConcurrency?: number;
}

const {
  class: className,
  heading,
  whenEmpty = 'hide',
  lastfmUser: lastfmUserProp,
  lastfmApiKey,
  maxTracks,
  lastfmLimit,
  enablePreviews,
  itunesConcurrency,
} = Astro.props;

const lastfmUser =
  lastfmUserProp ?? (import.meta.env.LASTFM_USER || 'irPhunky');

const covers = await fetchListeningCovers({
  lastfmUser,
  lastfmApiKey,
  maxTracks,
  lastfmLimit,
  enablePreviews,
  itunesConcurrency,
});
---

{
  covers.length === 0 && whenEmpty === 'hide' ? null : (
    <div class:list={['listening-shelf-root', className]} data-listening-shelf>
      {heading && (
        <h2 class="mb-4 mt-0 text-2xl font-bold text-indigo-900">
          {heading}
        </h2>
      )}
      {covers.length === 0 ? (
        whenEmpty === 'message' && <p class="text-gray-600">No recent tracks right now.</p>
      ) : (
        <>
          <div class="listening-shelf-scroll">
            <div class="listening-shelf" style={{ '--count': String(covers.length) }}>
              {covers.map((cover, i) => (
                <div
                  class="album-art"
                  data-index={String(i)}
                  data-track={cover.track || 'Unknown track'}
                  data-artist={cover.artist || 'Unknown artist'}
                  data-preview-url={cover.previewUrl ?? undefined}
                  style={{
                    '--i': String(i),
                    zIndex: i + 1,
                  }}
                >
                  <div class="album-art-face">
                    <img src={cover.src} alt={cover.alt} loading="lazy" decoding="async" />
                  </div>
                </div>
              ))}
            </div>
            <div class="listening-track-line">
              <div
                class="listening-track-now"
                role="status"
                aria-live="polite"
                hidden
              />
            </div>
          </div>
        </>
      )}
    </div>
  )
}
{
  covers.length > 0 && (
    <script>
      import { initListeningShelves } from '../lib/listening-shelf/attach-behavior';
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initListeningShelves);
      } else {
        initListeningShelves();
      }
    </script>
  )
}
<style is:global>
  @reference "tailwindcss";

  .listening-shelf-scroll {
    @apply flex w-full min-w-0 flex-col gap-8 overflow-x-visible overflow-y-visible bg-transparent;
    container-type: inline-size;
  }

  .listening-shelf {
    --tile: min(8rem, calc(200cqi / (var(--count) + 1)));
    --step: calc(0.5 * var(--tile));
    position: relative;
    height: var(--tile);
    width: min(
      100%,
      calc((var(--count) + 1) * 0.5 * var(--tile))
    );
    max-width: 100%;
    margin-inline: auto;
    overflow: visible;
    background: transparent;
  }

  /* Outer shell stays the hit / layout box so peek transforms don’t drop hover / kill the 1s audio timer */
  .album-art {
    @apply absolute top-0 cursor-pointer bg-transparent;
    overflow: visible;
    left: calc(var(--i) * var(--step));
    width: var(--tile);
    height: var(--tile);
    margin: 0;
    transform: translateX(var(--peer-shift, 0px));
    transform-origin: center center;
    transition: transform 380ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .album-art-face {
    @apply h-full w-full drop-shadow-md;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    transform: rotate(0deg) scale(1);
    transform-origin: center center;
    transition:
      transform 380ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 380ms ease,
      top 380ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .album-art img {
    @apply block h-full w-full rounded-lg object-cover bg-transparent;
  }

  .listening-shelf .album-art.album-art--peek {
    z-index: 60;
  }

  .listening-shelf .album-art.album-art--peek .album-art-face {
    @apply drop-shadow-lg;
    top: -1.65rem;
    transform: rotate(-11deg) scale(1.5);
  }

  .listening-track-line {
    @apply relative w-full min-h-14 shrink-0;
  }

  .listening-track-now {
    @apply text-sm text-indigo-900;
    /* No transition: JS repositions often; animating left/transform made titles drift after hover */
  }

  .listening-track-now[hidden] {
    display: none;
  }

  .listening-track-now .listening-track-title {
    @apply block font-medium;
  }

  .listening-track-now .listening-track-artist {
    @apply block text-gray-600;
  }
</style>
