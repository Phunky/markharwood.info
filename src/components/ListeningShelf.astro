---
/**
 * `user.getrecenttracks` returns per-track album art; weekly charts often only include the generic Last.fm placeholder.
 */
const LASTFM_USER = 'irPhunky';
const LASTFM_API_KEY = '3e434c7a4ee434d124cf935094da3c7e';
const LASTFM_RECENT = `https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=${LASTFM_USER}&api_key=${LASTFM_API_KEY}&format=json&limit=24`;

const PLACEHOLDER_MARKERS = ['2a96cbd8b46e442fc41c2b86b821562f'];

const sizeOrder: Record<string, number> = {
  mega: 5,
  extralarge: 4,
  large: 3,
  medium: 2,
  small: 1,
};

function coverUrl(track: {
  image?: Array<{ size?: string; '#text'?: string }> | { size?: string; '#text'?: string };
}) {
  const images = track?.image;
  if (!images) return '';
  const list = Array.isArray(images) ? images : [images];
  const sorted = [...list].sort(
    (a, b) => (sizeOrder[b?.size ?? ''] ?? 0) - (sizeOrder[a?.size ?? ''] ?? 0)
  );
  for (const im of sorted) {
    const url = im?.['#text'] ?? '';
    if (url) return url;
  }
  return '';
}

function artistName(track: { artist?: string | { '#text'?: string; name?: string } }) {
  const a = track.artist;
  if (typeof a === 'string') return a;
  return a?.['#text'] ?? a?.name ?? '';
}

function albumName(track: Record<string, unknown>): string {
  const al = track.album as { '#text'?: string } | undefined;
  return al?.['#text'] ?? '';
}

function isPlaceholder(url: string): boolean {
  if (!url) return true;
  return PLACEHOLDER_MARKERS.some((m) => url.includes(m));
}

async function itunesArtwork(artist: string, track: string, album: string): Promise<string | null> {
  const term = [artist, track, album].filter(Boolean).join(' ').slice(0, 200);
  if (!term.trim()) return null;
  try {
    const u = new URL('https://itunes.apple.com/search');
    u.searchParams.set('term', term);
    u.searchParams.set('limit', '1');
    u.searchParams.set('entity', 'song');
    const res = await fetch(u.toString(), { headers: { Accept: 'application/json' } });
    if (!res.ok) return null;
    const data = (await res.json()) as { results?: Array<{ artworkUrl100?: string }> };
    const art = data.results?.[0]?.artworkUrl100;
    if (!art) return null;
    return art.replace(/100x100bb\.jpg/i, '600x600bb.jpg');
  } catch {
    return null;
  }
}

type Cover = { src: string; alt: string; track: string; artist: string };

export interface Props {
  class?: string;
  /** e.g. "Recently listening" — omit to render no title */
  heading?: string;
  /** When the API returns no art */
  whenEmpty?: 'hide' | 'message';
}

const { class: className, heading, whenEmpty = 'hide' } = Astro.props;

let covers: Cover[] = [];

try {
  const res = await fetch(LASTFM_RECENT);
  if (!res.ok) throw new Error(String(res.status));
  const data = await res.json();
  const raw = data?.recenttracks?.track;
  const list = Array.isArray(raw) ? raw : raw ? [raw] : [];

  const seen = new Set<string>();
  const unique: Record<string, unknown>[] = [];
  for (const item of list) {
    const t = item as Record<string, unknown>;
    const nm = (t.name as string | undefined) ?? '';
    const art = artistName(t as Parameters<typeof artistName>[0]);
    const key = `${art.toLowerCase()}|${nm.toLowerCase()}`;
    if (seen.has(key)) continue;
    seen.add(key);
    unique.push(t);
    if (unique.length >= 16) break;
  }

  const enriched = await Promise.all(
    unique.map(async (track) => {
      let src = coverUrl(track as Parameters<typeof coverUrl>[0]);
      const artist = artistName(track as Parameters<typeof artistName>[0]);
      const name = (track.name as string | undefined) ?? '';
      const album = albumName(track);
      const alt = name ? `${name} — ${artist}` : artist;

      if (isPlaceholder(src)) {
        const fallback = await itunesArtwork(artist, name, album);
        if (fallback) src = fallback;
      }

      if (!src || isPlaceholder(src)) return null;
      return { src, alt, track: name, artist };
    })
  );

  covers = enriched.filter((c): c is Cover => c !== null);
} catch {
  covers = [];
}
---

{
  covers.length === 0 && whenEmpty === 'hide' ? null : (
    <div class:list={['listening-shelf-root', className]} data-listening-shelf>
      {heading && (
        <h2 class="mb-4 mt-0 text-2xl font-bold text-indigo-900">
          {heading}
        </h2>
      )}
      {covers.length === 0 ? (
        whenEmpty === 'message' && <p class="text-gray-600">No recent tracks right now.</p>
      ) : (
        <>
          <div class="listening-shelf-scroll">
            <div class="listening-shelf" style={{ '--count': String(covers.length) }}>
              {covers.map((cover, i) => (
                <div
                  class="album-art"
                  data-index={String(i)}
                  data-track={cover.track || 'Unknown track'}
                  data-artist={cover.artist || 'Unknown artist'}
                  style={{
                    '--i': String(i),
                    zIndex: i + 1,
                  }}
                >
                  <img src={cover.src} alt={cover.alt} loading="lazy" decoding="async" />
                </div>
              ))}
            </div>
            <div class="listening-track-line">
              <div
                class="listening-track-now"
                role="status"
                aria-live="polite"
                hidden
              />
            </div>
          </div>
        </>
      )}
    </div>
  )
}
{
  covers.length > 0 && (
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('[data-listening-shelf]').forEach((wrap) => {
          const root = wrap.querySelector('.listening-shelf-scroll');
          if (!root) return;
          const line = root.querySelector('.listening-track-line');
          const now = root.querySelector('.listening-track-now');
          if (!line || !now) return;
          const arts = root.querySelectorAll('.album-art');
          const peerNudgePx = (distance) => {
            if (distance < 1) return 0;
            const v = 24 * 0.56 ** (distance - 1);
            return Math.max(0, Math.round(v));
          };
          const EDGE = 0.24;
          const GUTTER = 8;
          const PEEK_DELAY_MS = 55;
          const PEEK_CLASS = 'album-art--peek';
          let peekTimer = null;
          let hovered = null;

          const placeLabel = (art) => {
            if (!art || now.hasAttribute('hidden')) return;
            const lineRect = line.getBoundingClientRect();
            const artRect = art.getBoundingClientRect();
            const w = lineRect.width;
            if (w < 1) return;
            const cx = artRect.left - lineRect.left + artRect.width * 0.5;
            const t = cx / w;
            const minCenterW = 120;
            const maxCenterW = Math.min(352, w - 2 * GUTTER);

            now.style.cssText = '';
            now.style.position = 'absolute';
            now.style.top = '0';
            now.style.left = '';
            now.style.right = 'auto';
            now.style.zIndex = '10';
            if (t < EDGE) {
              const left = Math.max(0, artRect.left - lineRect.left);
              now.style.left = left + 'px';
              now.style.transform = 'none';
              now.style.maxWidth = Math.max(minCenterW, w - left - GUTTER) + 'px';
              now.style.textAlign = 'left';
            } else if (t > 1 - EDGE) {
              const r = Math.max(0, lineRect.right - artRect.right);
              now.style.right = r + 'px';
              now.style.left = 'auto';
              now.style.transform = 'none';
              const spaceLeft = artRect.right - lineRect.left - GUTTER;
              now.style.maxWidth = Math.max(minCenterW, spaceLeft) + 'px';
              now.style.textAlign = 'right';
            } else {
              now.style.left = cx + 'px';
              now.style.transform = 'translateX(-50%)';
              now.style.maxWidth = maxCenterW + 'px';
              now.style.textAlign = 'center';
            }
          };

          const setNow = (el) => {
            hovered = el;
            const track = el.getAttribute('data-track') || '';
            const artist = el.getAttribute('data-artist') || '';
            now.textContent = '';
            const te = document.createElement('span');
            te.className = 'listening-track-title';
            te.textContent = track || 'Unknown track';
            const ar = document.createElement('span');
            ar.className = 'listening-track-artist';
            ar.textContent = artist || 'Unknown artist';
            now.append(te, ar);
            now.removeAttribute('hidden');
            placeLabel(el);
            requestAnimationFrame(() => placeLabel(el));
            requestAnimationFrame(() => requestAnimationFrame(() => placeLabel(el)));
          };

          const clearNow = () => {
            hovered = null;
            now.textContent = '';
            now.setAttribute('hidden', '');
            now.style.cssText = '';
          };

          const setPeerShift = (hoverIndex) => {
            for (const el of arts) {
              const i = Number(el.getAttribute('data-index'));
              if (Number.isNaN(i)) continue;
              if (i === hoverIndex) {
                el.style.setProperty('--peer-shift', '0px');
                continue;
              }
              const d = Math.abs(i - hoverIndex);
              const px = peerNudgePx(d);
              const signed = i < hoverIndex ? -px : px;
              el.style.setProperty('--peer-shift', `${signed}px`);
            }
          };

          const clearPeerShift = () => {
            for (const el of arts) {
              el.style.removeProperty('--peer-shift');
            }
          };

          for (const el of arts) {
            el.addEventListener('mouseenter', () => {
              const i = Number(el.getAttribute('data-index'));
              clearTimeout(peekTimer);
              peekTimer = setTimeout(() => {
                peekTimer = null;
                for (const a of arts) a.classList.remove(PEEK_CLASS);
                el.classList.add(PEEK_CLASS);
                if (!Number.isNaN(i)) setPeerShift(i);
                setNow(el);
              }, PEEK_DELAY_MS);
            });
            el.addEventListener('mousemove', () => {
              if (el.classList.contains(PEEK_CLASS)) placeLabel(el);
            });
            el.addEventListener('transitionend', (e) => {
              if (
                hovered === el &&
                el.classList.contains(PEEK_CLASS) &&
                (e.propertyName === 'transform' || e.propertyName === 'top')
              ) {
                placeLabel(el);
              }
            });
          }
          root.addEventListener('mouseleave', () => {
            clearTimeout(peekTimer);
            peekTimer = null;
            for (const a of arts) a.classList.remove(PEEK_CLASS);
            clearPeerShift();
            clearNow();
          });
          window.addEventListener('resize', () => {
            if (hovered) placeLabel(hovered);
          });
        });
      });
    </script>
  )
}
<style is:global>
  @reference "tailwindcss";

  .listening-shelf-scroll {
    @apply flex w-full min-w-0 flex-col gap-8 overflow-x-visible overflow-y-visible bg-transparent;
    container-type: inline-size;
  }

  .listening-shelf {
    --tile: min(8rem, calc(200cqi / (var(--count) + 1)));
    --step: calc(0.5 * var(--tile));
    position: relative;
    height: var(--tile);
    width: min(
      100%,
      calc((var(--count) + 1) * 0.5 * var(--tile))
    );
    max-width: 100%;
    margin-inline: auto;
    overflow: visible;
    background: transparent;
  }

  .album-art {
    @apply absolute top-0 cursor-pointer bg-transparent drop-shadow-md;
    overflow: visible;
    left: calc(var(--i) * var(--step));
    width: var(--tile);
    height: var(--tile);
    margin: 0;
    transform: translateX(var(--peer-shift, 0px)) rotate(0deg) scale(1);
    transform-origin: center center;
    transition:
      transform 380ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 380ms ease,
      top 380ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .album-art img {
    @apply block h-full w-full rounded-lg object-cover bg-transparent;
  }

  .listening-shelf .album-art.album-art--peek {
    @apply drop-shadow-lg;
    z-index: 60;
    top: -1.65rem;
    transform: translateX(0) rotate(-11deg) scale(1.5);
  }

  .listening-track-line {
    @apply relative w-full min-h-14 shrink-0;
  }

  .listening-track-now {
    @apply text-sm text-indigo-900;
    transition:
      left 0.1s ease-out,
      right 0.1s ease-out,
      transform 0.1s ease-out,
      max-width 0.1s ease-out;
  }

  .listening-track-now[hidden] {
    display: none;
  }

  .listening-track-now .listening-track-title {
    @apply block font-medium;
  }

  .listening-track-now .listening-track-artist {
    @apply block text-gray-600;
  }
</style>
