---
import '../styles/global.css';

export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
    <main class="p-8 lg:ml-32 max-w-screen-lg">
    <a href="/">
      <span class="lg:absolute lg:left-0 lg:top-0 lg:ml-8 lg:mt-8">
        <img
          src="/img/mark-headshot.png"
          class="w-24 h-24 shadow rounded-full object-cover"
          alt="Headshot of Mark Harwood"
        />
      </span>
    </a>
    <header class="h-24">
      <h1 class="font-bold text-4xl mb-0">
        Mark Harwood
      </h1>
      <nav class="text-sm uppercase text-gray-600">
        <a href="/now">
          Now
        </a>
        <a href="/uses">
          Uses
        </a>
        <a href="/homelab">
          Homelab
        </a>
      </nav>
    </header>
    <article class="sm:mt-8">
      <slot />
    </article>
  </main>
	</body>
</html>
